DIRECTUS_IMAGE=ghcr.io/directus/directus:12.0.2
POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:16-alpine

# Keep this on 127.0.0.1 and publish it through 1Panel/Caddy/Nginx with HTTPS.
# Use 0.0.0.0 only for a temporary direct-port test.
DEX2OAT_PANEL_BIND=127.0.0.1
DEX2OAT_PANEL_PORT=18083
DEX2OAT_PANEL_PUBLIC_URL=http://127.0.0.1:18083

POSTGRES_DB=dex2oat_directus
POSTGRES_USER=dex2oat_directus
POSTGRES_PASSWORD=replace-with-random-password

DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_ADMIN_EMAIL=admin@dex2oat.example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-random-admin-password

DIRECTUS_LOG_LEVEL=info
DIRECTUS_RATE_LIMITER_POINTS=600
DIRECTUS_RATE_LIMITER_DURATION=60
