#!/sbin/sh

umask 022

installer_print() {
  if command -v ui_print >/dev/null 2>&1; then
    ui_print "$@"
  else
    printf '%s\n' "$@"
  fi
}

require_module_manager() {
  installer_print "*******************************"
  installer_print " 请从 Magisk / KernelSU / APatch"
  installer_print " 管理器安装本模块。"
  installer_print "Recovery installation is not supported by KernelSU/APatch official design."
  installer_print "*******************************"
  exit 1
}

require_android_manager() {
  getprop sys.boot_completed 2>/dev/null | grep -q '^1$' && return 0
  ps 2>/dev/null | grep -q '[z]ygote' && return 0
  ps -A 2>/dev/null | grep -q '[z]ygote' && return 0
  require_module_manager
}

find_util_functions() {
  for UTIL_FUNCTIONS in \
    /data/adb/magisk/util_functions.sh \
    /data/adb/ksu/util_functions.sh \
    /data/adb/ap/util_functions.sh; do
    [ -f "$UTIL_FUNCTIONS" ] && return 0
  done
  return 1
}

DEX_STATE_ROOT=${DEX_STATE_ROOT:-/data/adb/dex2oat-lock}
DEX_MODULE_ROOT=${DEX_MODULE_ROOT:-/data/adb/modules/dex2oat-lock}
INSTALL_TXN_DIR=${INSTALL_TXN_DIR:-/data/local/tmp/dex2oat-lock-install-txn}
INSTALL_TXN_COMMITTED=0
DISCLAIMER_VERSION=${DEX2OAT_DISCLAIMER_VERSION:-v6.0-disclaimer-1}
DISCLAIMER_MIN_READ_WAIT=${DEX2OAT_DISCLAIMER_MIN_READ_WAIT:-8}
DISCLAIMER_KEY_TIMEOUT=${DEX2OAT_DISCLAIMER_KEY_TIMEOUT:-60}
DISCLAIMER_LINE_DELAY=${DEX2OAT_DISCLAIMER_LINE_DELAY:-0.35}

# Persistent legal acknowledgement storage. This directory is intentionally
# outside DEX_STATE_ROOT and DEX_MODULE_ROOT, and must not be added to
# preinstall_cleanup(): cleanup removes install state/module files, while this
# log records cross-install disclaimer acknowledgements.
DEX_PERSIST_ROOT=${DEX_PERSIST_ROOT:-/data/adb/.dex2oat-lock-persist}
DISCLAIMER_ACK_LOG="$DEX_PERSIST_ROOT/disclaimer_ack.log"
DEX_COMMON_READY=0

installer_line() {
  installer_print "────────────────────────────"
}

installer_find_keycheck() {
  for DEX_INSTALL_KEYCHECK in \
    /data/adb/magisk/keycheck \
    /data/adb/ksu/bin/keycheck \
    /data/adb/ap/bin/keycheck; do
    [ -x "$DEX_INSTALL_KEYCHECK" ] && { printf '%s\n' "$DEX_INSTALL_KEYCHECK"; return 0; }
  done
  command -v keycheck 2>/dev/null
}

installer_random_token() {
  if [ -r /proc/sys/kernel/random/uuid ]; then
    IFS= read -r DEX_INSTALL_RANDOM < /proc/sys/kernel/random/uuid
    printf '%s\n' "$DEX_INSTALL_RANDOM" | tr -d '-'
    return 0
  fi
  if command -v od >/dev/null 2>&1 && [ -r /dev/urandom ]; then
    od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n'
    return 0
  fi
  printf '%s%s\n' "$$" "$(date '+%s' 2>/dev/null)"
}

installer_private_temp_dir() {
  if [ -d /data/local/tmp ]; then
    DEX_INSTALL_TMP_BASE=/data/local/tmp
  else
    DEX_INSTALL_TMP_BASE="${TMPDIR:-/dev}"
  fi
  if command -v mktemp >/dev/null 2>&1; then
    DEX_INSTALL_TMP_DIR="$(mktemp -d "$DEX_INSTALL_TMP_BASE/dex2oat-install.XXXXXX" 2>/dev/null)" && {
      chmod 0700 "$DEX_INSTALL_TMP_DIR" 2>/dev/null || {
        rm -rf "$DEX_INSTALL_TMP_DIR" 2>/dev/null || true
        return 1
      }
      : > "$DEX_INSTALL_TMP_DIR/.dex2oat-temp-root" 2>/dev/null || {
        rm -rf "$DEX_INSTALL_TMP_DIR" 2>/dev/null || true
        return 1
      }
      printf '%s\n' "$DEX_INSTALL_TMP_DIR"
      return 0
    }
  fi
  DEX_INSTALL_TMP_TRY=0
  while [ "$DEX_INSTALL_TMP_TRY" -lt 20 ]; do
    DEX_INSTALL_TMP_TOKEN="$(installer_random_token)"
    DEX_INSTALL_TMP_DIR="$DEX_INSTALL_TMP_BASE/dex2oat-install.$DEX_INSTALL_TMP_TOKEN.$DEX_INSTALL_TMP_TRY"
    if ( umask 077 && mkdir "$DEX_INSTALL_TMP_DIR" ) 2>/dev/null; then
      chmod 0700 "$DEX_INSTALL_TMP_DIR" 2>/dev/null || {
        rm -rf "$DEX_INSTALL_TMP_DIR" 2>/dev/null || true
        return 1
      }
      : > "$DEX_INSTALL_TMP_DIR/.dex2oat-temp-root" 2>/dev/null || {
        rm -rf "$DEX_INSTALL_TMP_DIR" 2>/dev/null || true
        return 1
      }
      printf '%s\n' "$DEX_INSTALL_TMP_DIR"
      return 0
    fi
    DEX_INSTALL_TMP_TRY=$((DEX_INSTALL_TMP_TRY + 1))
  done
  return 1
}

installer_cleanup_temp_dir() {
  DEX_INSTALL_CLEANUP_DIR="$1"
  [ -n "$DEX_INSTALL_CLEANUP_DIR" ] || return 0
  [ -f "$DEX_INSTALL_CLEANUP_DIR/.dex2oat-temp-root" ] || return 0
  rm -rf "$DEX_INSTALL_CLEANUP_DIR" 2>/dev/null || true
}

installer_wait_volume_key() {
  DEX_INSTALL_WAIT="${1:-30}"
  DEX_INSTALL_WAITED=0
  DEX_INSTALL_EVENT_DIR="$(installer_private_temp_dir)" || return 2
  DEX_INSTALL_EVENT="$DEX_INSTALL_EVENT_DIR/key.event"
  while [ "$DEX_INSTALL_WAITED" -lt "$DEX_INSTALL_WAIT" ]; do
    DEX_INSTALL_GETEVENT=/system/bin/getevent
    [ -x "$DEX_INSTALL_GETEVENT" ] || DEX_INSTALL_GETEVENT=getevent
    if command -v "$DEX_INSTALL_GETEVENT" >/dev/null 2>&1; then
      if command -v timeout >/dev/null 2>&1; then
        timeout 1 "$DEX_INSTALL_GETEVENT" -l > "$DEX_INSTALL_EVENT" 2>/dev/null
      else
        "$DEX_INSTALL_GETEVENT" -l > "$DEX_INSTALL_EVENT" 2>/dev/null &
        DEX_INSTALL_EVENT_PID=$!
        sleep 1
        kill "$DEX_INSTALL_EVENT_PID" 2>/dev/null || true
        wait "$DEX_INSTALL_EVENT_PID" 2>/dev/null || true
      fi
      grep -E -q 'KEY_VOLUMEUP[[:space:]].*(DOWN|00000001)| 0073 00000001' "$DEX_INSTALL_EVENT" 2>/dev/null && { installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 0; }
      grep -E -q 'KEY_VOLUMEDOWN[[:space:]].*(DOWN|00000001)| 0072 00000001' "$DEX_INSTALL_EVENT" 2>/dev/null && { installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 1; }
    fi
    DEX_INSTALL_KEYCHECK="$(installer_find_keycheck)"
    if [ -n "$DEX_INSTALL_KEYCHECK" ]; then
      if command -v timeout >/dev/null 2>&1; then
        timeout 1 "$DEX_INSTALL_KEYCHECK" > "$DEX_INSTALL_EVENT" 2>&1
        DEX_INSTALL_KEY_CODE=$?
      else
        "$DEX_INSTALL_KEYCHECK" > "$DEX_INSTALL_EVENT" 2>&1 &
        DEX_INSTALL_KEY_PID=$!
        sleep 1
        if kill -0 "$DEX_INSTALL_KEY_PID" 2>/dev/null; then
          kill "$DEX_INSTALL_KEY_PID" 2>/dev/null || true
          wait "$DEX_INSTALL_KEY_PID" 2>/dev/null || true
          DEX_INSTALL_KEY_CODE=124
        else
          wait "$DEX_INSTALL_KEY_PID" 2>/dev/null
          DEX_INSTALL_KEY_CODE=$?
        fi
      fi
      case "$DEX_INSTALL_KEY_CODE" in
        42|115|24) installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 0 ;;
        41|114|25) installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 1 ;;
      esac
      grep -E -q 'KEY_VOLUMEUP|VOLUMEUP|(^|[^0-9])(42|115|24)([^0-9]|$)' "$DEX_INSTALL_EVENT" 2>/dev/null && { installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 0; }
      grep -E -q 'KEY_VOLUMEDOWN|VOLUMEDOWN|(^|[^0-9])(41|114|25)([^0-9]|$)' "$DEX_INSTALL_EVENT" 2>/dev/null && { installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"; return 1; }
    fi
    DEX_INSTALL_WAITED=$((DEX_INSTALL_WAITED + 1))
  done
  installer_cleanup_temp_dir "$DEX_INSTALL_EVENT_DIR"
  return 2
}

installer_temp_path() {
  TEMP_NAME="$1"
  DEX_INSTALL_TEMP_DIR="$(installer_private_temp_dir)" || return 1
  printf '%s/%s\n' "$DEX_INSTALL_TEMP_DIR" "$TEMP_NAME"
}

installer_source_common() {
  [ "$DEX_COMMON_READY" = 1 ] && return 0
  [ -n "${ZIPFILE:-}" ] || return 1
  command -v unzip >/dev/null 2>&1 || return 1
  DEX_COMMON_TMP_DIR="$(installer_private_temp_dir)" || return 1
  DEX_COMMON_TMP="$DEX_COMMON_TMP_DIR/common.sh"
  DEX2OAT_STATE_DIR="$DEX_PERSIST_ROOT"
  export DEX2OAT_STATE_DIR
  unzip -p "$ZIPFILE" core/common.sh > "$DEX_COMMON_TMP" 2>/dev/null || {
    installer_cleanup_temp_dir "$DEX_COMMON_TMP_DIR"
    return 1
  }
  . "$DEX_COMMON_TMP" || {
    installer_cleanup_temp_dir "$DEX_COMMON_TMP_DIR"
    return 1
  }
  installer_cleanup_temp_dir "$DEX_COMMON_TMP_DIR"
  DEX_COMMON_READY=1
}

