disclaimer_sleep_line() {
  sleep "$DISCLAIMER_LINE_DELAY" 2>/dev/null || sleep 1
}

disclaimer_timestamp() {
  installer_source_common || true
  if command -v dex_now >/dev/null 2>&1; then
    DISCLAIMER_TIME_BASE="$(dex_now)"
    DISCLAIMER_TIME_ZONE="$(date '+%z' 2>/dev/null)"
    if [ -n "$DISCLAIMER_TIME_ZONE" ]; then
      printf '%s %s\n' "$DISCLAIMER_TIME_BASE" "$DISCLAIMER_TIME_ZONE"
    else
      printf '%s\n' "$DISCLAIMER_TIME_BASE"
    fi
    return 0
  fi
  if command -v date >/dev/null 2>&1; then
    date '+%Y-%m-%d %H:%M:%S %z' 2>/dev/null && return 0
  fi
  printf 'unknown\n'
}

disclaimer_device() {
  DISCLAIMER_DEVICE="$(getprop ro.serialno 2>/dev/null)"
  [ -n "$DISCLAIMER_DEVICE" ] || DISCLAIMER_DEVICE="$(getprop ro.boot.serialno 2>/dev/null)"
  [ -n "$DISCLAIMER_DEVICE" ] || DISCLAIMER_DEVICE="$(getprop ro.product.device 2>/dev/null)"
  [ -n "$DISCLAIMER_DEVICE" ] || DISCLAIMER_DEVICE=unknown
  DISCLAIMER_DEVICE="$(printf '%s' "$DISCLAIMER_DEVICE" | tr -d '\r\n')"
  [ "$DISCLAIMER_DEVICE" != unknown ] || { printf 'unknown\n'; return 0; }
  installer_source_common || true
  if command -v dex_hash_file >/dev/null 2>&1; then
    DISCLAIMER_DEVICE_FILE="$(installer_temp_path dex2oat-disclaimer-device)"
    DISCLAIMER_DEVICE_DIR="${DISCLAIMER_DEVICE_FILE%/*}"
    printf '%s' "$DISCLAIMER_DEVICE" > "$DISCLAIMER_DEVICE_FILE" 2>/dev/null || {
      installer_cleanup_temp_dir "$DISCLAIMER_DEVICE_DIR"
      printf 'masked\n'
      return 0
    }
    DISCLAIMER_DEVICE_HASH="$(dex_hash_file "$DISCLAIMER_DEVICE_FILE")"
    installer_cleanup_temp_dir "$DISCLAIMER_DEVICE_DIR"
    if disclaimer_valid_sha256 "$DISCLAIMER_DEVICE_HASH"; then
      printf 'sha256:%s\n' "$DISCLAIMER_DEVICE_HASH"
      return 0
    fi
  fi
  printf 'masked\n'
}

disclaimer_log_warning() {
  installer_print "⚠ $*"
  mkdir -p "$DEX_STATE_ROOT" 2>/dev/null || return 0
  {
    printf '%s WARNING disclaimer %s\n' "$(disclaimer_timestamp)" "$*"
  } >> "$DEX_STATE_ROOT/install.log" 2>/dev/null || return 0
  chmod 0600 "$DEX_STATE_ROOT/install.log" 2>/dev/null || true
}

disclaimer_valid_sha256() {
  case "$1" in ""|*[!0-9a-fA-F]*) return 1 ;; esac
  [ "${#1}" -eq 64 ] 2>/dev/null
}

disclaimer_hash() {
  DISCLAIMER_TEXT_FILE="$(installer_temp_path dex2oat-disclaimer-text)"
  DISCLAIMER_TEXT_DIR="${DISCLAIMER_TEXT_FILE%/*}"
  disclaimer_text > "$DISCLAIMER_TEXT_FILE" 2>/dev/null || {
    installer_cleanup_temp_dir "$DISCLAIMER_TEXT_DIR"
    return 1
  }
  installer_source_common || {
    installer_cleanup_temp_dir "$DISCLAIMER_TEXT_DIR"
    return 1
  }
  DISCLAIMER_HASH_VALUE="$(dex_hash_file "$DISCLAIMER_TEXT_FILE")"
  installer_cleanup_temp_dir "$DISCLAIMER_TEXT_DIR"
  disclaimer_valid_sha256 "$DISCLAIMER_HASH_VALUE" || return 1
  printf '%s\n' "$DISCLAIMER_HASH_VALUE"
}

disclaimer_last_ack_value() {
  [ -f "$DISCLAIMER_ACK_LOG" ] && [ ! -L "$DISCLAIMER_ACK_LOG" ] || return 0
  awk -F= -v want="$1" '
    function commit() {
      if (version != "" || timestamp != "" || hash != "" || ack != "") {
        last_version = version
        last_timestamp = timestamp
        last_hash = hash
        last_ack = ack
      }
      version = ""; timestamp = ""; hash = ""; ack = ""
    }
    $0 == "---" { commit(); next }
    $1 == "version" { sub(/^[^=]*=/, ""); version = $0; next }
    $1 == "timestamp" { sub(/^[^=]*=/, ""); timestamp = $0; next }
    $1 == "hash" { sub(/^[^=]*=/, ""); hash = $0; next }
    $1 == "ack" { sub(/^[^=]*=/, ""); ack = $0; next }
    END {
      commit()
      if (want == "version") print last_version
      else if (want == "timestamp") print last_timestamp
      else if (want == "hash") print last_hash
      else if (want == "ack") print last_ack
    }
  ' "$DISCLAIMER_ACK_LOG" 2>/dev/null
}

disclaimer_ack_current() {
  [ -f "$DISCLAIMER_ACK_LOG" ] && [ ! -L "$DISCLAIMER_ACK_LOG" ] || return 1
  [ "$(disclaimer_last_ack_value version)" = "$DISCLAIMER_VERSION" ] || return 1
  [ "$(disclaimer_last_ack_value hash)" = "$1" ] || return 1
  [ "$(disclaimer_last_ack_value ack)" = "true" ] || return 1
}

disclaimer_prepare_persist_root() {
  case "$DEX_PERSIST_ROOT" in
    /data/adb/.dex2oat-lock-persist) ;;
    *) installer_print "❌ Installation Cancelled"; installer_print "原因: 持久化目录不在允许范围"; return 1 ;;
  esac
  case "$DEX_PERSIST_ROOT" in
    "$DEX_STATE_ROOT"|"$DEX_STATE_ROOT"/*|"$DEX_MODULE_ROOT"|"$DEX_MODULE_ROOT"/*)
      installer_print "❌ Installation Cancelled"
      installer_print "原因: 持久化目录不能位于状态目录或模块目录内"
      return 1
      ;;
  esac
  [ ! -L "$DEX_PERSIST_ROOT" ] || {
    installer_print "❌ Installation Cancelled"
    installer_print "原因: 持久化目录不能是符号链接"
    return 1
  }
  mkdir -p "$DEX_PERSIST_ROOT" 2>/dev/null || {
    installer_print "❌ Installation Cancelled"
    installer_print "原因: 无法创建免责声明确认目录"
    installer_print "$DEX_PERSIST_ROOT"
    return 1
  }
  [ ! -L "$DEX_PERSIST_ROOT" ] || return 1
  chmod 0700 "$DEX_PERSIST_ROOT" 2>/dev/null || disclaimer_log_warning "设置持久化目录权限失败: $DEX_PERSIST_ROOT"
  DISCLAIMER_WRITE_TEST="$DEX_PERSIST_ROOT/.write-test.$$"
  : > "$DISCLAIMER_WRITE_TEST" 2>/dev/null || {
    installer_print "❌ Installation Cancelled"
    installer_print "原因: 免责声明确认目录不可写"
    installer_print "$DEX_PERSIST_ROOT"
    return 1
  }
  rm -f "$DISCLAIMER_WRITE_TEST" 2>/dev/null || true
}

disclaimer_write_ack_unlocked() {
  DISCLAIMER_HASH_VALUE="$1"
  DISCLAIMER_TIME_VALUE="$2"
  DISCLAIMER_DEVICE_VALUE="$3"
  [ ! -L "$DISCLAIMER_ACK_LOG" ] || return 1
  DISCLAIMER_TMP_LOG="$DEX_PERSIST_ROOT/disclaimer_ack.log.tmp.$$"
  if [ -f "$DISCLAIMER_ACK_LOG" ]; then
    cat "$DISCLAIMER_ACK_LOG" > "$DISCLAIMER_TMP_LOG" 2>/dev/null || return 1
  else
    : > "$DISCLAIMER_TMP_LOG" 2>/dev/null || return 1
  fi
  {
    printf 'version=%s\n' "$DISCLAIMER_VERSION"
    printf 'timestamp=%s\n' "$DISCLAIMER_TIME_VALUE"
    printf 'hash=%s\n' "$DISCLAIMER_HASH_VALUE"
    printf 'device=%s\n' "$DISCLAIMER_DEVICE_VALUE"
    printf 'ack=true\n'
    printf '%s\n' '---'
  } >> "$DISCLAIMER_TMP_LOG" 2>/dev/null || {
    rm -f "$DISCLAIMER_TMP_LOG" 2>/dev/null || true
    return 1
  }
  command -v dex_atomic_commit >/dev/null 2>&1 || return 1
  dex_atomic_commit "$DISCLAIMER_TMP_LOG" "$DISCLAIMER_ACK_LOG" 0600 || return 1
  chmod 0600 "$DISCLAIMER_ACK_LOG" 2>/dev/null || disclaimer_log_warning "设置免责声明确认日志权限失败: $DISCLAIMER_ACK_LOG"
}

disclaimer_write_ack() {
  DISCLAIMER_HASH_VALUE="$1"
  DISCLAIMER_TIME_VALUE="$(disclaimer_timestamp)"
  DISCLAIMER_DEVICE_VALUE="$(disclaimer_device)"
  disclaimer_prepare_persist_root || return 1
  installer_source_common || return 1
  command -v dex_with_lock >/dev/null 2>&1 || return 1
  dex_with_lock "$DEX_PERSIST_ROOT/.disclaimer.lock" 10 disclaimer_write_ack_unlocked "$DISCLAIMER_HASH_VALUE" "$DISCLAIMER_TIME_VALUE" "$DISCLAIMER_DEVICE_VALUE"
}

disclaimer_export_agreement_state() {
  DEX2OAT_AGREEMENT_VERSION="$DISCLAIMER_VERSION"
  DEX2OAT_AGREEMENT_ACCEPTED=yes
  DEX2OAT_AGREEMENT_ACCEPTED_AT="$1"
  export DEX2OAT_AGREEMENT_VERSION DEX2OAT_AGREEMENT_ACCEPTED DEX2OAT_AGREEMENT_ACCEPTED_AT
}

disclaimer_show_text() {
  disclaimer_text | while IFS= read -r DISCLAIMER_LINE || [ -n "$DISCLAIMER_LINE" ]; do
    installer_print "$DISCLAIMER_LINE"
    disclaimer_sleep_line
  done
}

installation_agreement() {
  DISCLAIMER_HASH_VALUE="$(disclaimer_hash)" || {
    installer_print "❌ Installation Cancelled"
    installer_print "原因: 无法计算免责声明 SHA256"
    exit 2
  }

  if disclaimer_ack_current "$DISCLAIMER_HASH_VALUE"; then
    disclaimer_export_agreement_state "$(disclaimer_last_ack_value timestamp)"
    return 0
  fi

  installer_print ""
  disclaimer_show_text
  installer_print ""
  installer_print "阅读倒计时: ${DISCLAIMER_MIN_READ_WAIT}s"
  sleep "$DISCLAIMER_MIN_READ_WAIT" 2>/dev/null || sleep 8
  installer_print ""
  installer_print "现在可以确认。"
  installer_line
  installer_print "【音量 +】同意免责声明并继续安装"
  installer_print "【音量 -】不同意并取消安装"
  installer_line
  installer_wait_volume_key "$DISCLAIMER_KEY_TIMEOUT"
  DEX_AGREEMENT_STATUS=$?
  case "$DEX_AGREEMENT_STATUS" in
    0)
      disclaimer_write_ack "$DISCLAIMER_HASH_VALUE" || {
        installer_print "❌ Installation Cancelled"
        installer_print "原因: 写入免责声明确认记录失败"
        exit 2
      }
      disclaimer_export_agreement_state "$(disclaimer_last_ack_value timestamp)"
      installer_print "✓ 已确认免责声明，继续安装"
      return 0
      ;;
    1)
      installer_print "Installation Cancelled"
      installer_print "用户不同意免责声明，未执行安装步骤。"
      exit 2
      ;;
    *)
      installer_print "Installation Cancelled"
      installer_print "确认超时，未执行安装步骤。"
      exit 2
      ;;
  esac
}

install_transaction_manifest() {
  TXN_TREE="$1"
  TXN_MANIFEST="$2"
  [ -d "$TXN_TREE" ] && [ ! -L "$TXN_TREE" ] || return 1
  : > "$TXN_MANIFEST" || return 1
  find "$TXN_TREE" -mindepth 1 -print 2>/dev/null | sort | while IFS= read -r TXN_ENTRY; do
    TXN_RELATIVE=${TXN_ENTRY#"$TXN_TREE"/}
    if [ -L "$TXN_ENTRY" ]; then
      exit 1
    elif [ -d "$TXN_ENTRY" ]; then
      printf 'd\t%s\n' "$TXN_RELATIVE"
    elif [ -f "$TXN_ENTRY" ]; then
      TXN_SIZE="$(wc -c < "$TXN_ENTRY" 2>/dev/null | tr -d ' ')" || exit 1
      TXN_HASH="$(dex_hash_file "$TXN_ENTRY")" || exit 1
      [ -n "$TXN_HASH" ] || exit 1
      printf 'f\t%s\t%s\t%s\n' "$TXN_RELATIVE" "$TXN_SIZE" "$TXN_HASH"
    else
      exit 1
    fi
  done >> "$TXN_MANIFEST"
}

install_transaction_copy_verified() {
  TXN_SOURCE="$1"
  TXN_DESTINATION="$2"
  TXN_LABEL="$3"
  [ -d "$TXN_SOURCE" ] && [ ! -L "$TXN_SOURCE" ] || return 1
  rm -rf "$TXN_DESTINATION" 2>/dev/null || return 1
  cp -af "$TXN_SOURCE" "$TXN_DESTINATION" 2>/dev/null || return 1
  install_transaction_manifest "$TXN_SOURCE" "$INSTALL_TXN_DIR/.source.$TXN_LABEL.$$" || return 1
  install_transaction_manifest "$TXN_DESTINATION" "$INSTALL_TXN_DIR/.destination.$TXN_LABEL.$$" || return 1
  cmp -s "$INSTALL_TXN_DIR/.source.$TXN_LABEL.$$" "$INSTALL_TXN_DIR/.destination.$TXN_LABEL.$$" || return 1
  rm -f "$INSTALL_TXN_DIR/.source.$TXN_LABEL.$$" "$INSTALL_TXN_DIR/.destination.$TXN_LABEL.$$" || return 1
}

install_transaction_restore_tree() {
  TXN_BACKUP="$1"
  TXN_TARGET="$2"
  TXN_PRESENT_FILE="$3"
  TXN_LABEL="$4"
  TXN_STAGE="$TXN_TARGET.restore.$$"
  [ -f "$TXN_PRESENT_FILE" ] || return 1
  IFS= read -r TXN_PRESENT < "$TXN_PRESENT_FILE"
  case "$TXN_PRESENT" in
    0)
      rm -rf "$TXN_STAGE" "$TXN_TARGET" 2>/dev/null || return 1
      return 0
      ;;
    1)
      [ -d "$TXN_BACKUP" ] || return 1
      mkdir -p "${TXN_TARGET%/*}" 2>/dev/null || return 1
      install_transaction_copy_verified "$TXN_BACKUP" "$TXN_STAGE" "restore-$TXN_LABEL" || return 1
      rm -rf "$TXN_TARGET" 2>/dev/null || return 1
      mv "$TXN_STAGE" "$TXN_TARGET" 2>/dev/null || return 1
      install_transaction_manifest "$TXN_BACKUP" "$INSTALL_TXN_DIR/.backup.$TXN_LABEL.$$" || return 1
      install_transaction_manifest "$TXN_TARGET" "$INSTALL_TXN_DIR/.restored.$TXN_LABEL.$$" || return 1
      cmp -s "$INSTALL_TXN_DIR/.backup.$TXN_LABEL.$$" "$INSTALL_TXN_DIR/.restored.$TXN_LABEL.$$" || return 1
      rm -f "$INSTALL_TXN_DIR/.backup.$TXN_LABEL.$$" "$INSTALL_TXN_DIR/.restored.$TXN_LABEL.$$" || return 1
      ;;
    *)
      return 1
      ;;
  esac
}

install_transaction_restore() {
  install_transaction_restore_tree "$INSTALL_TXN_DIR/state" "$DEX_STATE_ROOT" "$INSTALL_TXN_DIR/had_state" state || return 1
  install_transaction_restore_tree "$INSTALL_TXN_DIR/module" "$DEX_MODULE_ROOT" "$INSTALL_TXN_DIR/had_module" module || return 1
}

install_transaction_recover_pending() {
  [ -f "$INSTALL_TXN_DIR/status" ] || return 0
  IFS= read -r TXN_STATUS < "$INSTALL_TXN_DIR/status"
  if [ "$TXN_STATUS" = committed ]; then
    rm -rf "$INSTALL_TXN_DIR" 2>/dev/null || return 1
    return 0
  fi
  [ "$TXN_STATUS" = prepared ] || return 1
  installer_print ""
  installer_print "⚠ 检测到未完成安装事务"
  installer_print "正在恢复上一版本……"
  install_transaction_restore || {
    installer_print "❌ 无法恢复上一版本"
    installer_print "事务目录已保留:"
    installer_print "$INSTALL_TXN_DIR"
    return 1
  }
  installer_print "✓ 已恢复上一版本"
  installer_print "继续安装……"
  rm -rf "$INSTALL_TXN_DIR" 2>/dev/null || return 1
}

install_transaction_prepare() {
  rm -rf "$INSTALL_TXN_DIR" 2>/dev/null || return 1
  mkdir -p "$INSTALL_TXN_DIR" 2>/dev/null || return 1
  chmod 0700 "$INSTALL_TXN_DIR" 2>/dev/null || return 1
  if [ -d "$DEX_STATE_ROOT" ]; then
    printf '1\n' > "$INSTALL_TXN_DIR/had_state" || return 1
    install_transaction_copy_verified "$DEX_STATE_ROOT" "$INSTALL_TXN_DIR/state" state || return 1
  else
    printf '0\n' > "$INSTALL_TXN_DIR/had_state" || return 1
  fi
  if [ -d "$DEX_MODULE_ROOT" ]; then
    printf '1\n' > "$INSTALL_TXN_DIR/had_module" || return 1
    install_transaction_copy_verified "$DEX_MODULE_ROOT" "$INSTALL_TXN_DIR/module" module || return 1
  else
    printf '0\n' > "$INSTALL_TXN_DIR/had_module" || return 1
  fi
  chmod 0600 "$INSTALL_TXN_DIR/had_state" "$INSTALL_TXN_DIR/had_module" 2>/dev/null || return 1
  printf 'prepared\n' > "$INSTALL_TXN_DIR/status.tmp.$$" 2>/dev/null || return 1
  mv "$INSTALL_TXN_DIR/status.tmp.$$" "$INSTALL_TXN_DIR/status" 2>/dev/null || return 1
  chmod 0600 "$INSTALL_TXN_DIR/status" 2>/dev/null || return 1
}

install_transaction_rollback() {
  [ "$INSTALL_TXN_COMMITTED" = 1 ] && return 0
  [ -d "$INSTALL_TXN_DIR" ] || return 0
  installer_print "⚠ 安装未提交"
  installer_print "正在恢复上一版本……"
  install_transaction_restore || {
    installer_print "❌ 无法恢复上一版本"
    installer_print "事务目录已保留:"
    installer_print "$INSTALL_TXN_DIR"
    return 1
  }
  installer_print "✓ 已恢复上一版本"
}

install_transaction_commit_valid() {
  [ -s "$DEX_STATE_ROOT/install.commit" ] || return 1
  TXN_MODULE_PATH="$(sed -n 's/^module_path=//p' "$DEX_STATE_ROOT/install.commit" 2>/dev/null | head -n 1)"
  [ -n "$TXN_MODULE_PATH" ] && [ -d "$TXN_MODULE_PATH" ] && [ ! -L "$TXN_MODULE_PATH" ] || return 1
  for TXN_REQUIRED in module.prop customize.sh service.sh action.sh uninstall.sh system.prop core/state.sh core/integrity-check.sh; do
    [ -f "$TXN_MODULE_PATH/$TXN_REQUIRED" ] && [ ! -L "$TXN_MODULE_PATH/$TXN_REQUIRED" ] || return 1
  done
  [ -x "$TXN_MODULE_PATH/service.sh" ] || return 1
  [ -x "$TXN_MODULE_PATH/action.sh" ] || return 1
  [ -x "$TXN_MODULE_PATH/customize.sh" ] || return 1
  [ -x "$TXN_MODULE_PATH/uninstall.sh" ] || return 1
}

install_transaction_finish() {
  install_transaction_commit_valid || return 1
  printf 'committed\n' > "$INSTALL_TXN_DIR/status.tmp.$$" 2>/dev/null || return 1
  mv "$INSTALL_TXN_DIR/status.tmp.$$" "$INSTALL_TXN_DIR/status" 2>/dev/null || return 1
  INSTALL_TXN_COMMITTED=1
  rm -rf "$INSTALL_TXN_DIR" 2>/dev/null || return 1
}

preinstall_cleanup() {
  for CLEANUP_TARGET in "$DEX_STATE_ROOT" "$DEX_MODULE_ROOT"; do
    case "$CLEANUP_TARGET" in
      /data/adb/dex2oat-lock|/data/adb/modules/dex2oat-lock)
        if [ -e "$CLEANUP_TARGET" ]; then
          rm -rf "$CLEANUP_TARGET" 2>/dev/null || {
            installer_print "❌ Installation Failed"
            installer_print "原因: 清理旧版本目录失败"
            installer_print "建议: 检查目录权限后重新安装。"
            installer_print "$CLEANUP_TARGET"
            exit 1
          }
        fi
        ;;
      *)
        installer_print "❌ Installation Failed"
        installer_print "原因: 拒绝清理非预期目录"
        installer_print "建议: 检查安装环境变量后重新安装。"
        installer_print "$CLEANUP_TARGET"
        exit 1
        ;;
    esac
  done
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null
require_android_manager
if find_util_functions; then
  . "$UTIL_FUNCTIONS"
else
  require_module_manager
fi
installation_agreement
install_transaction_recover_pending || { installer_print "❌ Installation Failed"; installer_print "原因: 无法恢复未完成安装事务"; installer_print "建议: 保留事务目录并重新安装。"; exit 1; }
install_transaction_prepare || { installer_print "❌ Installation Failed"; installer_print "原因: 无法准备安装事务"; installer_print "建议: 检查 /data/local/tmp 可写空间后重新安装。"; exit 1; }
trap 'install_transaction_rollback' EXIT HUP INT TERM
preinstall_cleanup

install_module
install_transaction_finish || exit 1
trap - EXIT HUP INT TERM
exit 0
