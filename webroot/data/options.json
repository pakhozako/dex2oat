{
  "categories": [
    {
      "id": "safe",
      "title": "安全",
      "tone": "safe",
      "description": "日常推荐配置，优先保证稳定性和兼容性。",
      "items": [
        {
          "id": "pm_bg_dexopt",
          "label": "跳过后台 dexopt",
          "description": "控制后台自动 dexopt 场景，减少后台重编译触发。",
          "prop": "pm.dexopt.bg-dexopt",
          "defaultEnabled": true,
          "defaultValue": "skip",
          "values": ["skip", "speed-profile", "verify"]
        },
        {
          "id": "pm_boot_after_ota",
          "label": "OTA 后编译策略",
          "description": "系统 OTA 后的包编译策略。",
          "prop": "pm.dexopt.boot-after-ota",
          "defaultEnabled": true,
          "defaultValue": "speed-profile",
          "values": ["verify", "speed-profile", "speed", "everything"]
        },
        {
          "id": "pm_mainline",
          "label": "Mainline 更新后编译策略",
