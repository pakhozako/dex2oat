        {
          "id": "force_install_everything",
          "label": "安装时强制 everything",
          "description": "安装阶段全量 AOT，安装更慢、占用更高。",
          "prop": "pm.dexopt.install",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["speed-profile", "speed", "everything"]
        },
        {
          "id": "force_ota_everything",
          "label": "OTA 后强制 everything",
          "description": "OTA 后尽量全量编译，可能增加开机后负载。",
          "prop": "pm.dexopt.boot-after-ota",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["speed-profile", "speed", "everything"]
        },
        {
          "id": "force_cmdline_everything",
          "label": "手动编译强制 everything",
          "description": "命令行触发 dexopt 时使用 everything。",
          "prop": "pm.dexopt.cmdline",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["speed-profile", "speed", "everything"]
        },
        {
          "id": "priv_apps_oob",
          "label": "特权 App 编译策略",
          "description": "启用 priv-apps-oob everything。",
          "prop": "pm.dexopt.priv-apps-oob",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["verify", "speed-profile", "speed", "everything"]
        },
        {
          "id": "priv_apps_oob_list",
          "label": "特权 App 列表",
          "description": "将特权 App OOB 列表设为 ALL。",
          "prop": "pm.dexopt.priv-apps-oob-list",
          "defaultEnabled": false,
          "defaultValue": "ALL",
          "values": ["ALL"]
        },
        {
          "id": "secondary_everything",
          "label": "secondary dex 编译策略",
          "description": "对 secondary dex 使用 everything。",
          "prop": "pm.dexopt.secondary",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["verify", "speed-profile", "speed", "everything"]
        },
        {
          "id": "global_everything",
          "label": "默认 dex2oat filter everything",
          "description": "将全局 dex2oat filter 设为 everything。",
          "prop": "dalvik.vm.dex2oat-filter",
          "defaultEnabled": false,
          "defaultValue": "everything",
          "values": ["verify", "speed-profile", "speed", "everything"]
        },
        {
          "id": "disable_art_service",
          "label": "禁用 ART Service 调度器",
          "description": "可能影响系统正常 dexopt 调度和维护任务。",
          "prop": "dalvik.vm.useartservice",
          "defaultEnabled": false,
          "defaultValue": "false",
          "values": ["false", "true"]
        },
        {
          "id": "disable_jit",
          "label": "禁用 JIT 即时编译",
          "description": "可能降低 App 长时间运行性能。",
          "prop": "dalvik.vm.usejit",
          "defaultEnabled": false,
          "defaultValue": "false",
          "values": ["false", "true"]
        },
        {
          "id": "disable_pr_dexopt",
          "label": "禁用 Package Reference dexopt",
          "description": "关闭 PR dexopt，可能影响 profile 相关优化。",
          "prop": "dalvik.vm.enable_pr_dexopt",
          "defaultEnabled": false,
          "defaultValue": "false",
          "values": ["false", "true"]
        },
        {
          "id": "disable_ota_pr",
          "label": "禁用 OTA 异步 pr_dexopt",
          "description": "关闭 OTA 后的异步 PR dexopt。",
          "prop": "dalvik.vm.pr_dexopt_async_for_ota",
          "defaultEnabled": false,
          "defaultValue": "false",
          "values": ["false", "true"]
        },
        {
          "id": "disable_secondary_auto",
          "label": "禁用 secondary dex 自动编译",
          "description": "可能影响插件化、大型 App 或动态加载场景。",
          "prop": "dalvik.vm.dexopt.secondary",
          "defaultEnabled": false,
          "defaultValue": "false",
          "values": ["false", "true"]
        },
        {
          "id": "disable_thermal_cutoff",
          "label": "关闭 dexopt 温控截断",
          "description": "发热风险较高，不建议日常使用。",
          "prop": "dalvik.vm.dexopt.thermal-cutoff",
          "defaultEnabled": false,
          "defaultValue": "0",
          "values": ["0", "1", "2"]
        },
        {
          "id": "disable_artfile_madvise",
          "label": "禁用 ART 文件预读缓存",
          "description": "关闭 ART 文件 madvise 预读缓存。",
          "prop": "dalvik.vm.madvise.artfile.size",
          "defaultEnabled": false,
          "defaultValue": "0",
          "values": ["0", "2147483647"]
        },
        {
          "id": "jit_max_zero",
          "label": "JIT 代码缓存上限设 0",
          "description": "极限压制 JIT 代码缓存。",
          "prop": "dalvik.vm.jitmaxsize",
          "defaultEnabled": false,
          "defaultValue": "0",
          "values": ["0", "64m"]
        },
        {
          "id": "profile_save_max",
          "label": "profile 保存间隔设最大值",
          "description": "延长 profile 保存间隔，减少 profile 写入。",
          "prop": "dalvik.vm.ps-min-save-period-ms",
          "defaultEnabled": false,
          "defaultValue": "2147483647",
          "values": ["30000", "2147483647"]
        }
      ]
    }
  ]
}
