# ============================================================
# Dex2oat Lock - Xiaomi system.prop
# Xiaomi / Redmi / POCO dexopt safe defaults
# ============================================================

# ============================================================
# Safe
# ============================================================

# Package dexopt policies
pm.dexopt.bg-dexopt=skip
pm.dexopt.boot-after-ota=verify
pm.dexopt.boot-after-mainline-update=verify
pm.dexopt.install=speed-profile
pm.dexopt.install-bulk=speed-profile
pm.dexopt.install-bulk-downgraded=verify
pm.dexopt.install-bulk-secondary=verify
pm.dexopt.install-bulk-secondary-downgraded=verify
pm.dexopt.install-fast=skip
pm.dexopt.post-boot=verify
pm.dexopt.first-boot=verify
pm.dexopt.first-use=verify
pm.dexopt.shared=speed
pm.dexopt.inactive=verify
pm.dexopt.ab-ota=speed-profile
pm.dexopt.cmdline=verify

# Debug info and runtime cache
dalvik.vm.dex2oat-minidebuginfo=false
dalvik.vm.minidebuginfo=false
persist.device_config.runtime_native.use_app_image_startup_cache=false
persist.device_config.runtime_native_boot.iorap_readahead_enable=false
persist.device_config.runtime_native_boot.iorap_perfetto_enable=false

# MIUI/HyperOS private compile and preload triggers
persist.miui.dexopt.first_use=false
persist.sys.app_dexfile_preload.enable=false
persist.sys.art_startup_class_preload.enable=false
persist.sys.precache.enable=false

# ============================================================
# Caution - disabled by default
# ============================================================

# dex2oat threads
# dalvik.vm.dex2oat-threads=0
# dalvik.vm.background-dex2oat-threads=0
# dalvik.vm.bg-dex2oat-threads=0
# dalvik.vm.boot-dex2oat-threads=0
# persist.dalvik.vm.dex2oat-threads=0
# system_perf_init.dex2oat-threads=0
# system_perf_init.bg-dex2oat-threads=0
# system_perf_init.boot-dex2oat-threads=0

# dex2oat heap
# dalvik.vm.dex2oat-Xms=32m
# dalvik.vm.dex2oat-Xmx=256m
# dalvik.vm.image-dex2oat-Xms=32m
# dalvik.vm.image-dex2oat-Xmx=32m

# ART profile and madvise
# dalvik.vm.ps-min-first-save-ms=2147483647
# dalvik.vm.madvise.artfile.size=0
# dalvik.vm.madvise.odexfile.size=0
# dalvik.vm.madvise.vdexfile.size=0

# Compile trigger controls
# dalvik.vm.dex2oat-resolve-startup-strings=false
# dalvik.vm.dexopt.secondary=false
# dalvik.vm.dexopt.thermal-cutoff=0
# dalvik.vm.enable_pr_dexopt=false
# dalvik.vm.usejitprofiles=false

# Xiaomi dex preload CPU binding
# persist.sys.dexpreload.cpu_cores=
# persist.sys.dexpreload.big_prime_cores=
# persist.sys.dexpreload.other_cores=

# ============================================================
# Aggressive - disabled by default
# ============================================================

# pm.dexopt.install=everything
# pm.dexopt.bg-dexopt=everything
# pm.dexopt.cmdline=everything
# pm.dexopt.first-use=everything
# pm.dexopt.secondary=everything
# dalvik.vm.dex2oat-filter=everything
# dalvik.vm.useartservice=false
# dalvik.vm.usejit=false
